async function loadConfig(){
  const r = await api('api/config');
  if(!r || r.ok === false){ toast('读取配置失败','fail'); return; }

  const $ = id => document.getElementById(id);
  const setCur = (id, v) => { const e=$(id); if(e) e.textContent = '当前: ' + v; };
  const chk = (id, v) => { const e=$(id); if(e) e.checked = (v === 'true' || v === true); };

  chk('cfg-mention', r.requireMention);
  chk('cfg-stream', r.streaming);
  chk('cfg-tool', r.showToolResults);
  chk('cfg-debug', r.debug);

  setCur('cur-mention', r.requireMention);
  setCur('cur-stream', r.streaming);
  setCur('cur-tool', r.showToolResults);
  setCur('cur-debug', r.debug);
  setCur('cur-c2c', r.c2cMode);
  setCur('cur-group', r.groupMode);
  setCur('cur-model', r.model);

  const c2c = $('cfg-c2c'); if(c2c) c2c.value = r.c2cMode || 'open';
  const grp = $('cfg-group'); if(grp) grp.value = r.groupMode || 'open';

  // 模型列表
  const sel = $('cfg-model');
  if(sel){
    const m = await api('api/models');
    if(m && m.list){
      sel.innerHTML = m.list.map(x=>`<option ${x===r.model?'selected':''}>${h(x)}</option>`).join('');
    }
  }
  toast('配置已加载','ok');
}

async function saveConfig(){
  const $ = id => document.getElementById(id);
  const items = [
    ['model', $('cfg-model').value],
    ['requireMention', $('cfg-mention').checked ? 'true' : 'false'],
    ['streaming', $('cfg-stream').checked ? 'true' : 'false'],
    ['showToolResults', $('cfg-tool').checked ? 'true' : 'false'],
    ['debug', $('cfg-debug').checked ? 'true' : 'false'],
    ['c2cMode', $('cfg-c2c').value],
    ['groupMode', $('cfg-group').value],
  ];

  let okN = 0, failN = 0;
  for(const [k,v] of items){
    const r = await api('api/config-set?key='+encodeURIComponent(k)+'&value='+encodeURIComponent(v));
    if(r && r.ok) okN++; else failN++;
  }
  toast(`保存完成：成功 ${okN} 项，失败 ${failN} 项`, failN>0?'fail':'ok');
  if(okN > 0) loadConfig();
}

async function loadPersona(){
  const r = await api('api/persona-text');
  const $ = id => document.getElementById(id);
  if(!r || r.ok === false){ toast('读取人格失败','fail'); return; }
  const ta = $('persona-text'); if(ta) ta.value = r.text || '';
  const info = $('persona-info');
  if(info) info.textContent = `${r.size} 字符 · ${r.title||''}`;
}

async function savePersona(){
  const ta = document.getElementById('persona-text');
  if(!ta) return;
  if(ta.value.length < 50){ toast('内容太短（至少 50 字符）','fail'); return; }
  const r = await api('api/persona-save?text='+encodeURIComponent(ta.value));
  toast(r.ok ? (r.msg||'已保存') : ('保存失败: '+(r.msg||'')), r.ok?'ok':'fail');
  if(r.ok) loadPersona();
}
// ============ 状态刷新 ============
let statusTimer=null;
async function refreshStatus(){
  const s = await api('api/status');
  console.log('[refreshStatus] 收到:', JSON.stringify(s).slice(0,200));
  if(!s || s.ok === false) { console.warn('[refreshStatus] 数据无效', s); return; }
  const $ = id => document.getElementById(id);

  // 侧栏
  const botDot = document.getElementById('sdot-bot');
  const gwDot = document.getElementById('sdot-gw');
  if(botDot){
    botDot.className = 'dot '+(s.bot?'on':'off');
    document.getElementById('stext-bot').textContent = '机器人 '+(s.bot?'运行中':'已停止');
  }
  if(gwDot){
    gwDot.className = 'dot '+(s.gateway==='正常'?'on':(s.gateway==='降级'?'warn':'off'));
    document.getElementById('stext-gw').textContent = '网关 '+(s.gateway||'未知');
  }

  // 概览指标卡
  const setV = (id, val, cls) => {
    const e = $(id); if(!e) return;
    e.textContent = val;
    if(cls !== undefined) e.className = 'metric-v sm ' + cls;
  };
  setV('m-pid', s.pid || '-');
  setV('m-uptime', s.uptime || '-');
  setV('m-persona', s.persona || '-');
  setV('m-dns', s.dns || '-', s.dnsHijacked ? 'danger' : 'ok');

  // 详情
  const setD = (id, val, color) => {
    const e = $(id); if(!e) return;
    e.textContent = val;
    if(color) e.style.color = color;
  };
  setD('d-bot', s.bot?'运行中':'已停止', s.bot?'var(--ok)':'var(--text-3)');
  setD('d-gw', s.gateway||'-', s.gateway==='正常'?'var(--ok)':(s.gateway==='降级'?'var(--warn)':'var(--text-3)'));
  setD('d-conn', s.conn>0 ? s.conn+' 条' : (s.conn===0?'无连接':'—'), s.conn>0?'var(--ok)':null);
  setD('d-fullpersona', s.personaFull||'-');
  setD('d-tun', s.tun===null?'Clash 未运行':(s.tun?'开启（会劫持）':'已关闭'), s.tun?'var(--warn)':'var(--ok)');
  if($('m-checked')) $('m-checked').textContent = '更新于 '+(s.time||'');
  if($('p-cur')) $('p-cur').textContent = s.personaFull||'-';

  // 自检结果缓存
  if(s.checks) window._lastChecks = s.checks;
}
setInterval(()=>{ if(cur==='overview') refreshStatus(); }, 3000);
