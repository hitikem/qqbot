<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>QQ Bot</title>
<style>
:root{
  --bg:oklch(0.978 0.00265 286.35);
  --surface:#fff;
  --surface-2:oklch(0.9767 0.00265 286.35);
  --inset:oklch(0.93517 0.00535 286.30);
  --sidebar:oklch(0.92123 0.0046 258.33);
  --sidebar-fg:oklch(0.43287 0.01676 258.37);
  --sidebar-muted:oklch(0.512 0.02088 261.29);
  --nav-hover:oklch(0.145 0 0 / 5%);
  --nav-sel:oklch(0.89318 0.04237 253.82);
  --nav-sel-bd:oklch(0.83311 0.05788 254.15);
  --nav-sel-fg:oklch(0.42649 0.12275 255.6);
  --text:oklch(0.145 0 0);
  --text-2:oklch(0.37 0 0);
  --text-3:oklch(0.49 0 0);
  --border:oklch(0.145 0 0 / 10%);
  --border-strong:oklch(0.145 0 0 / 20%);
  --control:oklch(0.95815 0 0);
  --control-hover:oklch(0.93214 0.00536 286.30);
  --primary:oklch(0.603 0.218 257.3);
  --primary-hover:oklch(0.543 0.218 257.3);
  --primary-soft:color-mix(in srgb,var(--primary) 10%,white);
  --primary-fg:oklch(0.48 0.2 257.3);
  --ok:oklch(0.596 0.145 163.225);
  --ok-soft:color-mix(in srgb,var(--ok) 10%,white);
  --warn:oklch(0.681 0.162 75.834);
  --warn-soft:color-mix(in srgb,var(--warn) 10%,white);
  --danger:oklch(0.577 0.245 27.325);
  --danger-soft:color-mix(in srgb,var(--danger) 10%,white);
  --radius:1rem;
  --shadow-2:0 1px 3px oklch(0.145 0 0/6%),0 10px 26px -16px oklch(0.145 0 0/20%);
  --font:"Segoe UI","Microsoft YaHei","Microsoft YaHei UI",system-ui,sans-serif;
  --mono:Consolas,"Cascadia Mono",monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:13.5px;-webkit-font-smoothing:antialiased}
button{font-family:inherit;font-size:inherit;cursor:pointer;border:none;background:none;color:inherit}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:oklch(0.145 0 0/18%);border-radius:5px;border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-thumb:hover{background:oklch(0.145 0 0/30%);background-clip:content-box}
::-webkit-scrollbar-track{background:transparent}

.shell{display:grid;grid-template-columns:216px 1fr;height:100vh}

/* ============ 侧栏 ============ */
.sidebar{background:var(--sidebar);display:flex;flex-direction:column;border-right:1px solid var(--border)}
.brand{height:56px;display:flex;align-items:center;gap:10px;padding:0 18px;flex-shrink:0}
.brand-icon{width:26px;height:26px;border-radius:8px;background:var(--primary);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px}
.brand-text{font-weight:700;font-size:14px;color:var(--sidebar-fg)}
.nav{padding:8px;flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:2px}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;color:var(--sidebar-fg);font-weight:500;transition:background .12s;text-align:left;width:100%}
.nav-item:hover{background:var(--nav-hover)}
.nav-item.active{background:var(--nav-sel);color:var(--nav-sel-fg);font-weight:600;box-shadow:inset 0 0 0 1px var(--nav-sel-bd)}
.nav-item .ico{width:16px;height:16px;flex-shrink:0;opacity:.75}
.nav-item.active .ico{opacity:1}

.side-foot{padding:12px 16px;border-top:1px solid var(--border);flex-shrink:0;display:flex;flex-direction:column;gap:7px;font-size:11.5px;color:var(--sidebar-muted)}
.sf-row{display:flex;align-items:center;gap:7px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--text-3);flex-shrink:0;transition:.2s}
.dot.on{background:var(--ok);box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 18%,transparent)}
.dot.warn{background:var(--warn);box-shadow:0 0 0 3px color-mix(in srgb,var(--warn) 18%,transparent)}
.dot.off{background:var(--text-3)}

/* ============ 主区 ============ */
.main{display:flex;flex-direction:column;overflow:hidden}
.topbar{height:50px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;flex-shrink:0}
.page-title{font-size:15px;font-weight:650}
.topbar-right{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--text-3)}
.content{flex:1;overflow-y:auto;padding:20px}
.page{display:none;animation:fade .18s}
.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}

/* ============ 卡片 ============ */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-2);overflow:hidden}
.card-h{padding:14px 18px 0;font-size:13px;font-weight:650;display:flex;align-items:center;justify-content:space-between}
.card-b{padding:14px 18px}
.card-sub{font-size:12px;color:var(--text-3);font-weight:400}

/* 指标网格 */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:14px}
.metric{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow-2)}
.metric-k{font-size:11.5px;color:var(--text-3);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.metric-v{font-size:19px;font-weight:700;letter-spacing:-.3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.metric-v.sm{font-size:14px}
.metric-v.ok{color:var(--ok)}
.metric-v.warn{color:var(--warn)}
.metric-v.danger{color:var(--danger)}

/* 详情网格 */
.detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px 24px}
.dg-item .k{font-size:11.5px;color:var(--text-3);margin-bottom:5px}
.dg-item .v{font-size:13.5px;font-weight:600}

/* 按钮 */
.btn{display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border-radius:9px;font-size:13px;font-weight:500;background:var(--control);border:1px solid var(--control-border,var(--border));color:var(--text);transition:.13s;white-space:nowrap}
.btn:hover{background:var(--control-hover);border-color:var(--border-strong)}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.btn.primary{background:var(--primary);color:#fff;border-color:transparent;font-weight:600;box-shadow:0 1px 2px oklch(0.145 0 0/6%),0 8px 20px -10px color-mix(in srgb,var(--primary) 55%,transparent)}
.btn.primary:hover{background:var(--primary-hover)}
.btn.danger{background:var(--danger-soft);color:var(--danger);border-color:color-mix(in srgb,var(--danger) 28%,white)}
.btn.warn{background:var(--warn-soft);color:var(--warn);border-color:color-mix(in srgb,var(--warn) 28%,white)}
.btn.sm{padding:6px 12px;font-size:12px;border-radius:8px}
.btn-row{display:flex;gap:9px;flex-wrap:wrap}

/* 表单 */
select,input[type=text],input[type=number],textarea{font-family:inherit;font-size:13px;padding:8px 11px;border-radius:9px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);outline:none;transition:.13s}
select:focus,input:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary) 18%,transparent)}
select{cursor:pointer}
textarea{resize:vertical;line-height:1.6}

/* 日志 */
.log{background:oklch(0.99 0.002 286);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-family:var(--mono);font-size:11.5px;line-height:1.75;color:var(--text-2);overflow:auto;white-space:pre-wrap;word-break:break-all}
.log.big{height:calc(100vh - 260px)}
.log::-webkit-scrollbar{width:8px}

/* 操作记录 */
.op-list{max-height:calc(100vh - 300px);overflow-y:auto;font-family:var(--mono);font-size:11.5px;line-height:1.85}
.op-item{padding:7px 10px;border-radius:7px;margin-bottom:3px;background:var(--surface-2);border-left:2px solid var(--border-strong)}
.op-item.ok{border-left-color:var(--ok)}
.op-item.fail{border-left-color:var(--danger)}
.op-item.unk{border-left-color:var(--warn)}
.op-t{color:var(--text-3);margin-right:8px}
.op-a{font-weight:600;color:var(--text)}
.op-d{color:var(--text-2);margin-top:2px;padding-left:2px}

/* 自检表 */
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{text-align:left;padding:9px 12px;color:var(--text-3);font-weight:600;font-size:11.5px;border-bottom:1px solid var(--border);background:var(--surface-2)}
td{padding:10px 12px;border-bottom:1px solid var(--border)}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--surface-2)}
.badge{display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:600}
.badge.ok{background:var(--ok-soft);color:var(--ok)}
.badge.fail{background:var(--danger-soft);color:var(--danger)}
.badge.unk{background:var(--warn-soft);color:var(--warn)}
.mono{font-family:var(--mono);font-size:11.5px}

/* 设置页 */
.cfg-row{display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--border)}
.cfg-row:last-child{border-bottom:none}
.cfg-label{flex:1;min-width:200px}
.cfg-k{font-size:13px;font-weight:600;margin-bottom:3px}
.cfg-d{font-size:11.5px;color:var(--text-3)}
.cfg-ctl{flex-shrink:0}
.cfg-cur{width:150px;text-align:right;font-size:11.5px;color:var(--text-3);font-family:var(--mono);flex-shrink:0}
/* 开关 */
.sw{position:relative;display:inline-block;width:44px;height:24px;cursor:pointer}
.sw input{opacity:0;width:0;height:0}
.sw span{position:absolute;inset:0;background:var(--control);border:1px solid var(--border-strong);border-radius:999px;transition:.2s}
.sw span:before{content:'';position:absolute;width:18px;height:18px;left:2px;top:2px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.sw input:checked + span{background:var(--primary);border-color:var(--primary)}
.sw input:checked + span:before{transform:translateX(20px)}
/* toast */
.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,80px);background:oklch(0.2 0 0);color:#fff;padding:11px 20px;border-radius:11px;font-size:13px;font-weight:500;opacity:0;transition:.28s cubic-bezier(.34,1.4,.64,1);z-index:999;max-width:80vw}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast.ok{background:var(--ok)}
.toast.fail{background:var(--danger)}
.toast.unk{background:var(--warn)}

.empty{text-align:center;padding:40px 20px;color:var(--text-3);font-size:12.5px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:1000px){.grid2{grid-template-columns:1fr}}
.spin{width:13px;height:13px;border:2px solid color-mix(in srgb,currentColor 25%,transparent);border-top-color:currentColor;border-radius:50%;animation:sp .7s linear infinite;display:inline-block}
@keyframes sp{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-icon">Q</div>
      <div class="brand-text">QQ Bot</div>
    </div>
    <nav class="nav" id="nav"></nav>
    <div class="side-foot">
      <div class="sf-row"><span class="dot off" id="sdot-bot"></span><span id="stext-bot">机器人 检测中</span></div>
      <div class="sf-row"><span class="dot off" id="sdot-gw"></span><span id="stext-gw">网关 检测中</span></div>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div class="page-title" id="pageTitle">概览</div>
      <div class="topbar-right"><span id="clock"></span></div>
    </div>
    <div class="content" id="content"></div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script>
const PAGES = [
  {id:'overview', name:'概览',   ico:'M3 12h4l2-7 3 14 2-9h5'},
  {id:'control',  name:'控制',   ico:'M12 3v9M5 12a7 7 0 1 0 14 0'},
  {id:'persona',  name:'人格',   ico:'M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1'},
  {id:'log',      name:'日志',   ico:'M5 3h10l4 4v14H5zM9 9h6M9 13h6M9 17h4'},
  {id:'check',    name:'自检',   ico:'M20 6L9 17l-5-5'},
  {id:'ai',       name:'AI 测试',ico:'M12 2l2 6 6 2-6 2-2 6-2-6-6-2 6-2z'},
  {id:'auto',     name:'自动化', ico:'M12 3a9 9 0 1 0 9 9M12 7v5l3 2'},
  {id:'setting',  name:'设置',   ico:'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z'},
];
let cur = 'overview';
let busy = false;

// ---------- 工具 ----------
function h(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(msg, kind='ok'){
  const t=document.getElementById('toast');
  t.textContent=msg; t.className='toast '+kind+' show';
  clearTimeout(window._tt);
  window._tt=setTimeout(()=>t.className='toast',3200);
}
// ---- postMessage 通信（避免 file:// 跨域问题）----
let _reqId = 0;
const _pending = new Map();
// WebView2 的消息必须用 chrome.webview.addEventListener，不是 window
function attachReceiver(){
  if(window.chrome && window.chrome.webview){
    window.chrome.webview.addEventListener('message', (e) => {
      const d = e.data;
      if(!d || d.type !== 'reply') return;
      const cb = _pending.get(d.id);
      if(cb){ _pending.delete(d.id); cb(d.payload); }
    });
    return true;
  }
  return false;
}
// WebView2 可能在脚本执行后才注入，用轮询确保挂上
let _attached = false;
(function waitWebView(n){
  if(attachReceiver()){ _attached = true; return; }
  if(n <= 0) return;
  setTimeout(()=>waitWebView(n-1), 50);
})(40);
async function api(path){
  if(!window.chrome || !window.chrome.webview){
    console.error('[api] WebView2 未就绪');
    return {ok:false,msg:'WebView2 未就绪'};
  }
  console.log('[api] 请求:', path);
  return new Promise((resolve)=>{
    const id = ++_reqId;
    _pending.set(id, resolve);
    window.chrome.webview.postMessage({type:'req', id:id, path:path});
    setTimeout(()=>{ if(_pending.has(id)){ _pending.delete(id); resolve({ok:false,msg:'超时'}); } }, 60000);
  });
}

// ---------- 导航 ----------
function renderNav(){
  document.getElementById('nav').innerHTML = PAGES.map(p=>`
    <button class="nav-item ${p.id===cur?'active':''}" onclick="go('${p.id}')">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${p.ico}"/></svg>
      <span>${p.name}</span>
    </button>`).join('');
}
function go(id){
  cur=id;
  renderNav();
  document.getElementById('pageTitle').textContent = PAGES.find(p=>p.id===id).name;
  render();
}

// ---------- 页面 ----------
function render(){
  const c = document.getElementById('content');
  switch(cur){
    case 'overview': c.innerHTML = pageOverview(); refreshStatus(); break;
    case 'control':  c.innerHTML = pageControl(); loadOps(); break;
    case 'persona':  c.innerHTML = pagePersona(); loadPersonas(); break;
    case 'log':      c.innerHTML = pageLog(); loadLog(); break;
    case 'check':    c.innerHTML = pageCheck(); break;
    case 'ai':       c.innerHTML = pageAI(); break;
    case 'auto':     c.innerHTML = pageAuto(); loadAuto(); break;
    case 'setting':  c.innerHTML = pageSetting(); loadConfig(); break;
  }
}

// ============ 概览 ============
function pageOverview(){
  return `
  <div class="metrics">
    <div class="metric"><div class="metric-k">进程 PID</div><div class="metric-v sm" id="m-pid">-</div></div>
    <div class="metric"><div class="metric-k">运行时长</div><div class="metric-v" id="m-uptime">-</div></div>
    <div class="metric"><div class="metric-k">当前人格</div><div class="metric-v sm" id="m-persona">-</div></div>
    <div class="metric"><div class="metric-k">QQ API 解析</div><div class="metric-v sm" id="m-dns">-</div></div>
  </div>
  <div class="card" style="margin-bottom:14px">
    <div class="card-h">运行详情 <span class="card-sub" id="m-checked"></span></div>
    <div class="card-b">
      <div class="detail-grid">
        <div class="dg-item"><div class="k">机器人</div><div class="v" id="d-bot">-</div></div>
        <div class="dg-item"><div class="k">网关</div><div class="v" id="d-gw">-</div></div>
        <div class="dg-item"><div class="k">出站连接 (443)</div><div class="v" id="d-conn">-</div></div>
        <div class="dg-item"><div class="k">完整人格名</div><div class="v" id="d-fullpersona" style="font-size:12.5px">-</div></div>
        <div class="dg-item"><div class="k">Clash TUN</div><div class="v" id="d-tun">-</div></div>
        <div class="dg-item"><div class="k">控制台</div><div class="v" id="d-console">运行中</div></div>
      </div>
    </div>
  </div>
  <div class="btn-row">
    <button class="btn" onclick="act('refresh')">刷新状态</button>
    <button class="btn primary" onclick="goCheck()">立即自检</button>
    <button class="btn" onclick="act('restart')">重启机器人</button>
  </div>`;
}

// ============ 控制 ============
function pageControl(){
  return `
  <div class="card" style="margin-bottom:14px">
    <div class="card-h">机器人操作</div>
    <div class="card-b">
      <div class="btn-row">
        <button class="btn primary" onclick="act('start')">▶ 启动</button>
        <button class="btn" onclick="act('stop')">■ 停止</button>
        <button class="btn" onclick="act('restart')">⟳ 重启</button>
        <button class="btn" onclick="act('gateway')">检查网关</button>
        <button class="btn warn" onclick="act('tun')">关闭 TUN</button>
        <button class="btn" onclick="act('dns')">DNS 检测</button>
      </div>
    </div>
  </div>
  <div class="grid2">
    <div class="card"><div class="card-h">操作记录</div><div class="card-b"><div class="op-list" id="oplist"><div class="empty">还没有操作</div></div></div></div>
    <div class="card"><div class="card-h">执行详情</div><div class="card-b"><div class="log" id="detail" style="min-height:200px">点上方按钮执行，这里显示完整命令、结果、验证。</div></div></div>
  </div>`;
}

// ============ 人格 ============
function pagePersona(){
  return `
  <div class="card">
    <div class="card-h">人格切换</div>
    <div class="card-b">
      <div style="margin-bottom:14px;font-size:12.5px;color:var(--text-3)">当前：<b id="p-cur" style="color:var(--text)">-</b></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <select id="p-sel" style="min-width:280px"></select>
        <button class="btn primary" onclick="applyPersona()">应用并重启</button>
        <button class="btn" onclick="act('opendir')">打开人格目录</button>
      </div>
    </div>
  </div>`;
}

// ============ 日志 ============
function pageLog(){
  return `
  <div style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;align-items:center">
    <select id="log-sel" onchange="loadLog()" style="min-width:200px">
      <option value="run-out.log">run-out.log（运行）</option>
      <option value="run-err.log">run-err.log（错误）</option>
      <option value="autostart.log">autostart.log（启动）</option>
      <option value="console.log">console.log（控制台）</option>
      <option value="console-crash.log">console-crash.log（崩溃）</option>
    </select>
    <button class="btn sm" onclick="loadLog()">刷新</button>
    <button class="btn sm" onclick="act('opendir')">打开目录</button>
  </div>
  <div class="log big" id="logbox">加载中…</div>`;
