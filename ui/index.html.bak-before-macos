async function doAI(){
  const m = document.getElementById('ai-model').value;
  const p = document.getElementById('ai-prompt').value;
  const box = document.getElementById('ai-reply');
  const res = document.getElementById('ai-res');
  if(!m){ toast('先加载模型列表','unk'); return; }
  box.textContent = '调用中…'; res.textContent='';
  const r = await api('api/ai?model='+encodeURIComponent(m)+'&prompt='+encodeURIComponent(p));
  if(r.ok){ box.textContent = r.reply; res.textContent = '✓ '+r.ms+'ms'; res.style.color='var(--ok)'; }
  else { box.textContent = '失败：\n'+r.msg; res.textContent='✗ 失败'; res.style.color='var(--danger)'; }
}

async function testAll(){
  const box = document.getElementById('ai-reply');
