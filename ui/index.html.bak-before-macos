async function runCheck(){
  const btn = document.getElementById('chkbtn');
  btn.disabled = true; btn.innerHTML = '<span class="spin"></span> 自检中…';
  const sum = document.getElementById('chksum');
  sum.textContent = '正在逐项验证…';

  await api('api/check');
  await new Promise(r=>setTimeout(r,2500));
  const r = await api('api/status');
  btn.disabled = false; btn.textContent = '重新自检';

  const tb = document.querySelector('#chktable tbody');
  if(!r.checks){ sum.textContent='自检失败'; return; }

  const items = r.checks;
  const pass = items.filter(x=>x.pass===true).length;
  const fail = items.filter(x=>x.pass===false).length;
  const unk = items.length - pass - fail;

  tb.innerHTML = items.map(i=>{
    const cls = i.pass===true?'ok':(i.pass===false?'fail':'unk');
    const txt = i.pass===true?'通过':(i.pass===false?'失败':'未知');
    return `<tr>
      <td>${h(i.name)}</td>
      <td><span class="badge ${cls}">${txt}</span></td>
      <td class="mono">${i.ms}ms</td>
      <td style="color:var(--text-2)">${h(i.detail||'')}</td>
    </tr>`;
  }).join('');

  sum.textContent = `通过 ${pass} · 失败 ${fail} · 未知 ${unk}`;
  sum.style.color = fail>0?'var(--danger)':(unk>0?'var(--warn)':'var(--ok)');
  toast(sum.textContent, fail>0?'fail':'ok');
}

function goCheck(){ go('check'); setTimeout(()=>runCheck(), 100); }

