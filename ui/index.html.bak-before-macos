// ============ 操作 ============
async function act(cmd){
  if(busy){ toast('上一个操作还在执行','unk'); return; }
  busy = true;
  const all = document.querySelectorAll('.btn');
  all.forEach(b=>b.disabled=true);
  toast('执行中…','unk');

  const r = await api('api/'+cmd);

  all.forEach(b=>b.disabled=false);
  busy = false;

  if(r.ok) toast(r.msg||'完成','ok');
  else toast(r.msg||'失败','fail');

  // 写详情
  const d = document.getElementById('detail');
  if(d && r.detail){
    d.textContent = r.detail + '\n\n' + d.textContent;
  }
  if(cur==='control') loadOps();
  refreshStatus();
}

async function loadOps(){
  const r = await api('api/ops');
  const box = document.getElementById('oplist');
  if(!box) return;
  if(!r.ops || !r.ops.length){ box.innerHTML='<div class="empty">还没有操作</div>'; return; }
  box.innerHTML = r.ops.map(o=>`
    <div class="op-item ${o.verify===true?'ok':(o.verify===false?'fail':'unk')}">
      <span class="op-t">${h(o.time)}</span><span class="op-a">${h(o.action)}</span>
      <div class="op-d">${h(o.result||'')}</div>
    </div>`).join('');
}

