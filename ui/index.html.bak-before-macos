async function saveAuto(){
  const on = document.getElementById('au-on').checked;
  const iv = document.getElementById('au-int').value;
  const ac = document.getElementById('au-act').value;
  const r = await api('api/auto?enabled='+(on?1:0)+'&interval='+iv+'&action='+ac);
  toast(r.msg||'已保存', r.ok?'ok':'fail');
  loadAuto();
}

