# dsh 配置层：qqbot profile 的本地覆盖
# 启动：dsh --profile qqbot --patch D:\ds\qqbot\patch.yml
#
# ⚠️ 部署时改这三处：
#   1. appId      -> 你的 QQ 机器人 AppID
#   2. appSecret  -> 你的 QQ 机器人 AppSecret
#   3. cwd        -> 你的 agent 目录绝对路径

# ── 模型 ────────────────────────────────────────────────
- id: llm-pi-ai
  name: '@deepseek-ai/dsh-llm-pi-ai'
  config:
    providers:
      local:
        displayName: Local Agent2API
        apiKeyEnv: AGENT2API_PROXY_API_KEY
        api: openai-completions
        baseURL: http://127.0.0.1:3065/v1
        models:
          - id: deepseek-v4.1-flash
            name: DeepSeek V4.1 Flash (本机网关)
            contextWindow: 1000000
            maxTokens: 64000
            input: [text, image]
          - id: hy3
            name: DeepSeek 官方主用 / WorkBuddy 备用
            contextWindow: 192000
            maxTokens: 64000
            input: [text, image]
      deepseek:
        displayName: DeepSeek 官方（备用）
        apiKeyEnv: DEEPSEEK_OFFICIAL_KEY
        api: openai-completions
        baseURL: https://api.deepseek.com/v1
        models:
          - id: deepseek-chat
            name: DeepSeek Chat（官方备用）
            contextWindow: 131072
            maxTokens: 8192
            input: [text]
          - id: deepseek-reasoner
            name: DeepSeek Reasoner（官方备用）
            contextWindow: 131072
            maxTokens: 8192
            input: [text]

# ── 人格 ────────────────────────────────────────────────
- id: system-prompt
  name: '@deepseek-ai/dsh-system-prompt'
  config:
    includeHarnessIdentity: false
    includeRuntimeContext: false
    persona: |-
      你是我多年的损友，不是助手。脾气差、嘴毒、爱抬杠、爱骂人。
      脏话密度要高（他妈的/我操/傻逼 随便用），短句口语，先怼再讲理。
      不写"首先/其次/最后"，不写"希望能帮到你"，不说"作为一个AI"。
      详细的人格、语气和例子见工作目录里的 AGENTS.md，那份优先。

# ── QQ 机器人通道 ────────────────────────────────────────
- id: im-qqbot
  name: '@tencent-connect/dsh-qqbot'
  config:
    appId: 'YOUR_APP_ID'
    appSecret: 'YOUR_APP_SECRET'
    provider: local
    model: deepseek-v4.1-flash
    cwd: D:\ds\qqbot\agent
    requireMention: true
    streaming: false
    media:
      enabled: true
    vision:
      enabled: true
      provider: local
      model: deepseek-v4.1-flash
      defaultPrompt: 请详细描述这张图片的内容。如果是题目、作业、文档或截图，把其中的文字、公式、数字完整念出来，然后再作解释。
      maxBytes: 10485760
      maxTokens: 4096
      timeoutMs: 60000
    showToolResults: false
    access:
      c2cMode: open
      groupMode: open
    debug: false
